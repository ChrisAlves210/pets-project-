extends layout

block content
  .row
    .col-sm-4
      if pet.avatarUrl
        img(src=pet.avatarUrl, alt='Image of ' + pet.name).img-fluid
      else if pet.picUrlSq
        img(src=pet.picUrlSq, alt='Image of ' + pet.name).img-fluid
    .col-sm-8
      h1=pet.name
      p=pet.species
      p Born on #{pet.birthday}
      p=pet.description
      p Price: $#{pet.price.toFixed(2)}
      form(action=`/pets/${pet._id}/purchase`, method='POST')
        script.stripe-button(src='https://checkout.stripe.com/checkout.js',
          data-key=PUBLIC_STRIPE_API_KEY,
          data-amount=pet.price * 100,
          data-name="Proud Pete's Pet Emporium",
          data-description=`${pet.name}, ${pet.species}`,
          data-image='https://stripe.com/img/documentation/checkout/marketplace.png',
          data-locale='auto',
          data-zip-code='true')
        input(type='hidden', name='petId', value=pet._id)
      .text-right
        a(href="/pets/" + pet.id + "/edit").btn-link Edit
      
